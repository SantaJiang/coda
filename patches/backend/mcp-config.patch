+
+function mcpEntryExists(text: string, name: string) {
+  const errors: { error: number }[] = []
+  const value = parse(text, errors, { allowTrailingComma: true }) as unknown
+  if (errors.length || !value || typeof value !== "object") return false
+  const mcp = (value as { mcp?: unknown }).mcp
+  return !!mcp && typeof mcp === "object" && !Array.isArray(mcp) && Object.prototype.hasOwnProperty.call(mcp, name)
+}
