index 0000000000..4b5f139f83
--- /dev/null
+++ b/packages/opencode/src/server/routes/instance/httpapi/groups/terminal.ts
@@ -0,0 +1,55 @@
+import { Schema } from "effect"
+import { HttpApi, HttpApiEndpoint, HttpApiGroup, HttpApiError } from "effect/unstable/httpapi"
+import { Authorization } from "../middleware/authorization"
+import { InstanceContextMiddleware } from "../middleware/instance-context"
+import { WorkspaceRoutingMiddleware, WorkspaceRoutingQueryFields } from "../middleware/workspace-routing"
+import { SessionID } from "@/session/schema"
+
+const query = Schema.Struct({ ...WorkspaceRoutingQueryFields })
+const params = { sessionID: SessionID, terminalID: Schema.String }
+export const TerminalApi = HttpApi.make("coda-terminal").add(
+  HttpApiGroup.make("terminal")
+    .add(
+      HttpApiEndpoint.get("list", "/session/:sessionID/terminals", {
+        params: { sessionID: SessionID },
+        query,
+        error: [HttpApiError.BadRequest, HttpApiError.NotFound],
+        success: Schema.Unknown,
+      }),
+      HttpApiEndpoint.get("logs", "/session/:sessionID/terminals/:terminalID/log", {
+        params,
+        query: Schema.Struct({
+          ...WorkspaceRoutingQueryFields,
+          cursor: Schema.optional(Schema.NumberFromString.check(Schema.isInt(), Schema.isGreaterThanOrEqualTo(0))),
+          limit: Schema.optional(
+            Schema.NumberFromString.check(
+              Schema.isInt(),
+              Schema.isGreaterThanOrEqualTo(1),
+              Schema.isLessThanOrEqualTo(262144),
+            ),
+          ),
+        }),
+        error: [HttpApiError.BadRequest, HttpApiError.NotFound],
+        success: Schema.Unknown,
+      }),
+      HttpApiEndpoint.get("stream", "/session/:sessionID/terminals/:terminalID/stream", {
+        params,
+        query: Schema.Struct({
+          ...WorkspaceRoutingQueryFields,
+          cursor: Schema.optional(Schema.NumberFromString.check(Schema.isInt(), Schema.isGreaterThanOrEqualTo(0))),
+        }),
+        error: [HttpApiError.BadRequest, HttpApiError.NotFound],
+        success: Schema.String,
+      }),
+      HttpApiEndpoint.post("control", "/session/:sessionID/terminals/:terminalID/control", {
+        params,
+        query,
+        payload: Schema.Struct({ action: Schema.Literals(["cancel", "hide", "show", "resume"]) }),
+        error: [HttpApiError.BadRequest, HttpApiError.NotFound],
+        success: Schema.Unknown,
+      }),
+    )
+    .middleware(InstanceContextMiddleware)
+    .middleware(WorkspaceRoutingMiddleware)
+    .middleware(Authorization),
+)
diff --git a/packages/opencode/src/server/routes/instance/httpapi/handlers/terminal.ts b/packages/opencode/src/server/routes/instance/httpapi/handlers/terminal.ts
new file mode 100644
index 0000000000..f7ede0949a
--- /dev/null
+++ b/packages/opencode/src/server/routes/instance/httpapi/handlers/terminal.ts
@@ -0,0 +1,125 @@
+import { Effect, Scope, Schedule } from "effect"
+import * as Stream from "effect/Stream"
+import { HttpApiBuilder, HttpApiError } from "effect/unstable/httpapi"
+import { HttpServerResponse } from "effect/unstable/http"
+import { InstanceHttpApi } from "../api"
+import { InstanceState } from "@/effect/instance-state"
+import { Session } from "@/session/session"
+import { SessionPrompt } from "@/session/prompt"
+import { SessionStatus } from "@/session/status"
+import { SessionID } from "@/session/schema"
+import * as Store from "@/terminal/store"
+import * as Client from "@/terminal/client"
+import { eligible, resume } from "@/terminal/recovery"
+import { InstanceStore } from "@/project/instance-store"
+
+export const terminalHandlers = HttpApiBuilder.group(InstanceHttpApi, "terminal", (handlers) =>
+  Effect.gen(function* () {
+    const sessions = yield* Session.Service
+    const prompt = yield* SessionPrompt.Service
+    const status = yield* SessionStatus.Service
+    const scope = yield* Scope.Scope
+    const instances = yield* InstanceStore.Service
+    const checked = Effect.fnUntraced(function* (params: { sessionID: SessionID; terminalID: string }) {
+      const directory = (yield* InstanceState.context).directory
+      yield* sessions.get(params.sessionID).pipe(Effect.mapError(() => new HttpApiError.NotFound({})))
+      const info = Store.list(directory, params.sessionID).find((info) => info.id === params.terminalID)
+      if (!info) return yield* Effect.fail(new HttpApiError.NotFound({}))
+      return yield* Effect.promise(() => Client.refresh(info.id))
+    })
+    const recover = (info: Store.Info) =>
+      resume(info, sessions, prompt, status).pipe(
+        Effect.catchCause((cause) => Effect.sync(() => Store.update(info.id, { error: String(cause) }))),
+      )
+    // Recovery belongs to the backend, including sessions not currently open in
+    // the WebView. Each session still shares the persisted stop guard and lock.
+    yield* Effect.gen(function* () {
+      if (Store.settings().taskRecovery === "manual") return
+      let owner: Store.Owner
+      try {
+        owner = Store.owner()
+      } catch {
+        return
+      }
+      const tasks = Store.list().filter((info) => eligible(info, owner.id) && !info.error)
+      for (const info of tasks)
+        yield* instances.provide({ directory: info.directory }, recover(info)).pipe(
+          Effect.catchCause((cause) => Effect.sync(() => Store.update(info.id, { error: String(cause) }))),
+          Effect.forkIn(scope),
+        )
+    }).pipe(
+      Effect.catchCause(() => Effect.void),
+      Effect.repeat(Schedule.spaced("5 seconds")),
+      Effect.forkIn(scope),
+    )
+    return handlers
+      .handle("list", ({ params }) =>
+        Effect.gen(function* () {
+          yield* sessions.get(params.sessionID).pipe(Effect.mapError(() => new HttpApiError.NotFound({})))
+          const directory = (yield* InstanceState.context).directory
+          const list = yield* Effect.promise(() =>
+            Promise.all(Store.list(directory, params.sessionID).map((info) => Client.refresh(info.id))),
+          )
+          let ownerID = ""
+          try {
+            ownerID = Store.owner().id
+          } catch {}
+          const candidates = list.map((info) => ({ ...info, recoverable: eligible(info, ownerID) }))
+          if (Store.settings().taskRecovery !== "manual") {
+            for (const info of candidates)
+              if (info.recoverable && !info.error) yield* recover(info).pipe(Effect.forkIn(scope))
+          }
+          return { backendID: Client.backendID, items: candidates }
+        }),
+      )
+      .handle("logs", ({ params, query }) =>
+        Effect.gen(function* () {
+          const info = yield* checked(params)
+          if (query.cursor !== undefined && (!Number.isSafeInteger(query.cursor) || query.cursor < 0))
+            return yield* Effect.fail(new HttpApiError.BadRequest({}))
+          return {
+            ...Store.log(info, query.cursor, Math.max(1, Math.min(256 * 1024, query.limit ?? 64 * 1024))),
+            status: info.status,
+          }
+        }),
+      )
+      .handleRaw("stream", ({ params, query }) =>
+        Effect.gen(function* () {
+          yield* checked(params)
+          let cursor = query.cursor
+          if (cursor !== undefined && (!Number.isSafeInteger(cursor) || cursor < 0))
+            return yield* Effect.fail(new HttpApiError.BadRequest({}))
+          const sample = Effect.promise(async () => {
+            const info = await Client.refresh(params.terminalID)
+            const output = Store.log(info, cursor)
+            cursor = output.cursor
+            return { ...output, status: info.status, ended: !Store.active(info) && cursor >= info.cursor }
+          })
+          const stream = Stream.make(0).pipe(
+            Stream.concat(Stream.tick("500 millis")),
+            Stream.mapEffect(() => sample),
+            Stream.takeUntil((frame) => frame.ended),
+            Stream.map((frame) => `data: ${JSON.stringify(frame)}\n\n`),
+            Stream.encodeText,
+          )
+          return HttpServerResponse.stream(stream, {
+            contentType: "text/event-stream",
+            headers: { "Cache-Control": "no-cache", "X-Accel-Buffering": "no" },
+          })
+        }),
+      )
+      .handle("control", ({ params, payload }) =>
+        Effect.gen(function* () {
+          const info = yield* checked(params)
+          if (payload.action === "cancel") return yield* Effect.promise(() => Client.cancel(info.id))
+          if (payload.action === "hide" || payload.action === "show") {
+            if (Store.active(info)) return yield* Effect.fail(new HttpApiError.BadRequest({}))
+            Store.update(info.id, { hidden: payload.action === "hide" })
+            return true
+          }
+          yield* recover(info).pipe(Effect.forkIn(scope))
+          return true
+        }),
+      )
+  }),
+)
diff --git a/packages/opencode/src/terminal/client.ts b/packages/opencode/src/terminal/client.ts
new file mode 100644
index 0000000000..55cb5291f2
--- /dev/null
+++ b/packages/opencode/src/terminal/client.ts
@@ -0,0 +1,301 @@
+import fs from "node:fs"
+import path from "node:path"
+import { spawn as ptySpawn } from "@opencode-ai/core/pty/pty.bun"
+import { spawnSync } from "node:child_process"
+import * as Store from "./store"
+
+type Entry = {
+  info: Store.Info
+  process: ReturnType<typeof ptySpawn>
+  listeners: { dispose(): void }[]
+  done: Promise<void>
+  settle(): void
+  exitCode?: number
+  timer?: ReturnType<typeof setTimeout>
+  killTimer?: ReturnType<typeof setTimeout>
+}
+const entries = new Map<string, Entry>()
+const MAX_LOG = 100 * 1024 * 1024
+const SEGMENT = 1024 * 1024
+export const backendID = `${process.pid}-${Date.now()}`
+let watcher: ReturnType<typeof setInterval> | undefined
+function persist(info: Store.Info) {
+  Store.atomic(path.join(Store.taskDir(info.id), "info.json"), info)
+}
+function kill(entry: Entry, force = false) {
+  if (process.platform === "win32") {
+    spawnSync("taskkill", ["/PID", String(entry.process.pid), "/T", "/F"], { windowsHide: true, stdio: "ignore" })
+    return
+  }
+  try {
+    process.kill(-entry.process.pid, force ? "SIGKILL" : "SIGTERM")
+  } catch {
+    try {
+      entry.process.kill(force ? "SIGKILL" : "SIGTERM")
+    } catch {}
+  }
+}
+function finish(entry: Entry, code?: number) {
+  if (!Store.active(entry.info)) return
+  try {
+    Store.owner()
+  } catch {
+    if (!entry.info.reason) {
+      const desktop = Store.json<Store.Owner>(path.join(Store.home(), "runtime", "desktop.json"))
+      entry.info.reason = desktop?.exiting ? "Cancelled: Coda exited" : "Interrupted: Coda desktop disconnected"
+    }
+    kill(entry, true)
+  }
+  if (entry.timer) clearTimeout(entry.timer)
+  if (entry.killTimer) {
+    entry.exitCode = code
+    return
+  }
+  entry.info.status = entry.info.reason?.startsWith("Cancelled")
+    ? "cancelled"
+    : entry.info.reason?.startsWith("Interrupted")
+      ? "interrupted"
+      : entry.info.reason
+        ? "failed"
+        : code === 0
+          ? "completed"
+          : "failed"
+  entry.info.exitCode = entry.info.reason ? undefined : code
+  entry.info.endedAt = Date.now()
+  persist(entry.info)
+  entry.settle()
+  for (const listener of entry.listeners) listener.dispose()
+  entries.delete(entry.info.id)
+  if (!entries.size && watcher) {
+    clearInterval(watcher)
+    watcher = undefined
+  }
+}
+function append(info: Store.Info, text: string) {
+  const bytes = Buffer.from(text)
+  for (let offset = 0; offset < bytes.length; ) {
+    let segment = info.segments.at(-1)
+    if (!segment || segment.size >= SEGMENT) {
+      segment = { name: `output-${info.cursor}.log`, start: info.cursor, size: 0 }
+      info.segments.push(segment)
+    }
+    const chunk = bytes.subarray(offset, offset + Math.min(SEGMENT - segment.size, bytes.length - offset))
+    fs.appendFileSync(path.join(Store.taskDir(info.id), segment.name), chunk, { mode: 0o600 })
+    segment.size += chunk.length
+    info.cursor += chunk.length
+    offset += chunk.length
+    while (info.cursor - info.baseCursor > MAX_LOG && info.segments.length > 1) {
+      const old = info.segments.shift()!
+      info.baseCursor = old.start + old.size
+      fs.rmSync(path.join(Store.taskDir(info.id), old.name), { force: true })
+    }
+  }
+  info.lastOutputAt = Date.now()
+  const plain = text.slice(-2048).replace(/\x1b\[[0-?]*[ -/]*[@-~]/g, "")
+  if (
+    /(?:password|username|authentication token)\s*:|press (?:enter|return|any key)|\[(?:y\/n|yes\/no)\]|\(y\/n\)/i.test(
+      plain,
+    )
+  )
+    Store.update(info.id, { needsInput: true })
+  persist(info)
+}
+function monitor() {
+  if (watcher) return
+  watcher = setInterval(() => {
+    for (const entry of entries.values()) {
+      try {
+        if (Store.owner().id === entry.info.ownerID) {
+          try {
+            process.kill(entry.process.pid, 0)
+          } catch (error) {
+            if ((error as NodeJS.ErrnoException).code === "ESRCH") {
+              entry.info.reason ??= "Interrupted: terminal exited without delivering its result"
+              finish(entry)
+            }
+          }
+          continue
+        }
+      } catch {}
+      entry.info.reason = "Interrupted: Coda desktop exited"
+      kill(entry, true)
+      finish(entry)
+    }
+  }, 1000)
+  watcher.unref()
+}
+process.once("exit", () => {
+  for (const entry of entries.values()) {
+    kill(entry, true)
+    entry.info.reason = "Interrupted: backend exited"
+    finish(entry)
+  }
+})
+export async function refresh(id: string) {
+  const entry = entries.get(id)
+  let info = entry?.info ?? Store.read(id)
+  if (!info) throw new Error("Terminal not found")
+  if (Store.active(info) && !entry) {
+    info = {
+      ...info,
+      status: "interrupted",
+      endedAt: Date.now(),
+      reason: "Interrupted: backend restarted; inspect project state before retrying",
+    }
+    persist(info)
+  }
+  return { ...info, ...Store.control(id) }
+}
+export async function start(
+  input: Omit<
+    Store.Info,
+    "id" | "ownerID" | "status" | "startedAt" | "lastOutputAt" | "cursor" | "baseCursor" | "segments"
+  > & { env: NodeJS.ProcessEnv; timeout?: number; wait_ms?: number },
+) {
+  const owner = Store.owner()
+  Store.cleanup()
+  const id = Store.idFor(input.sessionID, input.callID)
+  fs.mkdirSync(Store.root(), { recursive: true, mode: 0o700 })
+  try {
+    fs.mkdirSync(Store.taskDir(id), { mode: 0o700 })
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error
+    return refresh(id)
+  }
+  const { env, timeout, wait_ms: _, ...fields } = input
+  const now = Date.now()
+  const info: Store.Info = {
+    ...fields,
+    ownerID: owner.id,
+    id,
+    backendPID: process.pid,
+    startedAt: now,
+    lastOutputAt: now,
+    status: "starting",
+    cursor: 0,
+    baseCursor: 0,
+    segments: [],
+  }
+  persist(info)
+  Store.update(id, { consumed: false, suppressed: false })
+  try {
+    Store.owner()
+    const name = path
+      .basename(input.shell)
+      .toLowerCase()
+      .replace(/\.exe$/, "")
+    const args =
+      name === "cmd"
+        ? ["/d", "/s", "/c", "set /p _coda_ready= & " + input.command]
+        : /^(pwsh|powershell)$/.test(name)
+          ? ["-NoLogo", "-NoProfile", "-NonInteractive", "-Command", "$null = [Console]::ReadLine(); " + input.command]
+          : ["-c", 'read -r _coda_ready; exec "$0" -c "$1"', input.shell, input.command]
+    const proc = ptySpawn(input.shell, args, {
+      cwd: input.cwd,
+      cols: 120,
+      rows: 32,
+      name: "xterm-256color",
+      env: Object.fromEntries(
+        Object.entries(env).filter((item): item is [string, string] => typeof item[1] === "string"),
+      ),
+    })
+    let settle!: () => void
+    const done = new Promise<void>((resolve) => {
+      settle = resolve
+    })
+    const entry: Entry = { info, process: proc, listeners: [], done, settle }
+    entries.set(id, entry)
+    info.pid = proc.pid
+    info.status = "running"
+    persist(info)
+    entry.listeners.push(
+      proc.onData((text) => {
+        try {
+          append(info, text)
+        } catch (error) {
+          info.reason = `Unable to save terminal output: ${error}`
+          kill(entry, true)
+          finish(entry)
+        }
+      }),
+      proc.onExit(({ exitCode }) => finish(entry, exitCode)),
+    )
+    // bun-pty begins reading synchronously inside its constructor. Hold the command
+    // at a private input gate until both callbacks are installed, so fast exits are observable.
+    proc.write(process.platform === "win32" ? "\r" : "\n")
+    if (timeout)
+      entry.timer = setTimeout(() => {
+        info.reason = `Command exceeded explicit timeout of ${timeout} ms`
+        entry.killTimer = setTimeout(() => {
+          kill(entry, true)
+          entry.killTimer = undefined
+          finish(entry, entry.exitCode)
+        }, 3000)
+        kill(entry)
+      }, timeout)
+    monitor()
+    return { ...info, ...Store.control(id) }
+  } catch (error) {
+    info.status = "failed"
+    info.endedAt = Date.now()
+    info.reason = String(error)
+    persist(info)
+    throw error
+  }
+}
+export async function cancel(id: string) {
+  const info = await refresh(id)
+  Store.update(id, { suppressed: true, nextCheckAt: undefined })
+  const entry = entries.get(id)
+  if (!entry || !Store.active(info)) return info
+  entry.info.reason = "Cancelled by user"
+  if (entry.killTimer) {
+    await entry.done
+    return refresh(id)
+  }
+  entry.killTimer = setTimeout(() => {
+    kill(entry, true)
+    entry.killTimer = undefined
+    finish(entry, entry.exitCode)
+  }, 3000)
+  kill(entry)
+  await entry.done
+  return refresh(id)
+}
+export async function wait(id: string, waitMs: number, signal?: AbortSignal) {
+  const deadline = Date.now() + Math.max(0, Math.min(120_000, waitMs))
+  Store.update(id, { nextCheckAt: deadline })
+  try {
+    const entry = entries.get(id)
+    if (!entry || !Store.active(entry.info) || waitMs === 0) return refresh(id)
+    await new Promise<void>((resolve, reject) => {
+      const complete = () => {
+        clearTimeout(timer)
+        signal?.removeEventListener("abort", abort)
+        resolve()
+      }
+      const abort = () => {
+        clearTimeout(timer)
+        signal?.removeEventListener("abort", abort)
+        reject(signal?.reason ?? new Error("Aborted"))
+      }
+      const timer = setTimeout(complete, Math.max(0, deadline - Date.now()))
+      entry.done.then(complete)
+      if (signal?.aborted) abort()
+      else signal?.addEventListener("abort", abort, { once: true })
+    })
+    return refresh(id)
+  } finally {
+    Store.update(id, { nextCheckAt: undefined })
+  }
+}
+export async function stopSession(directory: string, sessionID: string, all: boolean, turnID?: string) {
+  const tasks = Store.list(directory, sessionID).filter(
+    (info) => !turnID || info.turnID === turnID || info.rootTurnID === turnID,
+  )
+  for (const info of tasks) Store.update(info.id, { suppressed: true })
+  if (all) await Promise.all(tasks.filter(Store.active).map((info) => cancel(info.id)))
+}
+export async function shutdown() {
+  await Promise.all([...entries.keys()].map(cancel))
+}
diff --git a/packages/opencode/src/terminal/desktop.ts b/packages/opencode/src/terminal/desktop.ts
new file mode 100644
index 0000000000..538102c976
--- /dev/null
+++ b/packages/opencode/src/terminal/desktop.ts
@@ -0,0 +1,15 @@
+import { owner } from "./store"
+import { shutdown } from "./client"
+
+// Owned sidecars must not outlive a crashed desktop, including during a model request.
+export function watchDesktop() {
+  if (!process.env.CODA_DESKTOP_OWNER) return
+  const timer = setInterval(() => {
+    try {
+      if (owner().id === process.env.CODA_DESKTOP_OWNER) return
+    } catch {}
+    clearInterval(timer)
+    void shutdown().finally(() => process.exit(0))
+  }, 1000)
+  timer.unref()
+}
diff --git a/packages/opencode/src/terminal/recovery.ts b/packages/opencode/src/terminal/recovery.ts
new file mode 100644
index 0000000000..f241614879
--- /dev/null
+++ b/packages/opencode/src/terminal/recovery.ts
@@ -0,0 +1,99 @@
+import { Effect } from "effect"
+import { Session } from "../session/session"
+import { SessionPrompt } from "../session/prompt"
+import { SessionStatus } from "../session/status"
+import { SessionID, PartID } from "../session/schema"
+import * as Store from "./store"
+import * as Client from "./client"
+import { result } from "./tools"
+import fs from "node:fs"
+
+export function eligible(info: Store.Info & Store.Control, ownerID: string) {
+  const checkpoint = Store.run(info.sessionID)
+  return (
+    info.ownerID === ownerID &&
+    !info.suppressed &&
+    !checkpoint?.suppressed &&
+    ((info.status === "interrupted" && !info.consumed) ||
+      Boolean(checkpoint?.active && checkpoint.backendID !== Client.backendID && checkpoint.turnID === info.turnID))
+  )
+}
+
+const recovering = new Set<string>()
+export function resume(
+  info: Store.Info,
+  sessions: Session.Interface,
+  prompt: SessionPrompt.Interface,
+  status: SessionStatus.Interface,
+) {
+  return Effect.gen(function* () {
+    const key = info.sessionID
+    if (recovering.has(key)) return
+    const currentStatus = (yield* status.list()).get(SessionID.make(key))
+    if (currentStatus && currentStatus.type !== "idle") return
+    recovering.add(key)
+    try {
+      Store.owner()
+      if (!fs.existsSync(info.directory)) throw new Error("项目目录不存在，请恢复目录后继续任务")
+      const current = Store.control(info.id)
+      const checkpoint = Store.run(key)
+      if (current.suppressed || checkpoint?.suppressed || (current.consumed && !checkpoint?.active)) return
+      const messages = yield* sessions.messages({ sessionID: SessionID.make(key) }).pipe(Effect.orDie)
+      const user = messages.findLast((message) => message.info.role === "user")
+      if (!user || user.info.id !== info.turnID || info.ownerID !== Store.owner().id) {
+        Store.update(info.id, { suppressed: true })
+        return
+      }
+      const tasks = Store.list(info.directory, key).filter(
+        (task) => task.sessionID === key && task.turnID === info.turnID && !task.suppressed,
+      )
+      for (const task of tasks) {
+        const next = yield* Effect.promise(() => Client.refresh(task.id))
+        const value = result(next)
+        for (const message of messages)
+          for (const part of message.parts) {
+            if (part.type !== "tool") continue
+            const terminalID = "metadata" in part.state ? part.state.metadata?.terminalID : undefined
+            if (terminalID !== task.id && !(message.info.id === task.messageID && part.callID === task.callID)) continue
+            yield* sessions.updatePart({
+              ...part,
+              state: {
+                status: "completed",
+                input: part.state.input,
+                title: value.title,
+                metadata: value.metadata,
+                output: value.output,
+                time: { start: task.startedAt, end: Date.now() },
+              },
+            })
+          }
+      }
+      const assistant = messages.findLast((message) => message.info.role === "assistant")
+      if (assistant?.info.role === "assistant")
+        yield* sessions.updateMessage({
+          ...assistant.info,
+          finish: "tool-calls",
+          error: undefined,
+          time: { ...assistant.info.time, completed: Date.now() },
+        })
+      Store.update(info.id, { error: undefined })
+      if (checkpoint?.active) {
+        const latestUser = messages.findLast((message) => message.info.role === "user")
+        if (latestUser)
+          yield* sessions.updatePart({
+            id: PartID.ascending(),
+            type: "text",
+            synthetic: true,
+            text: "[Coda recovery] The backend was interrupted. First inspect the project and existing command results. Do not replay an earlier command automatically.",
+            sessionID: latestUser.info.sessionID,
+            messageID: latestUser.info.id,
+          })
+      }
+      if (Store.control(info.id).suppressed || Store.run(key)?.suppressed) return
+      yield* prompt.loop({ sessionID: SessionID.make(key) })
+      for (const task of tasks) Store.update(task.id, { consumed: true })
+    } finally {
+      recovering.delete(key)
+    }
+  })
+}
diff --git a/packages/opencode/src/terminal/store.ts b/packages/opencode/src/terminal/store.ts
new file mode 100644
index 0000000000..747ab9055d
--- /dev/null
+++ b/packages/opencode/src/terminal/store.ts
@@ -0,0 +1,153 @@
+import fs from "node:fs"
+import path from "node:path"
+import os from "node:os"
+import { createHash, randomUUID } from "node:crypto"
+
+export type Status = "starting" | "running" | "completed" | "failed" | "cancelled" | "interrupted"
+export type Info = {
+  id: string
+  ownerID: string
+  directory: string
+  sessionID: string
+  rootSessionID: string
+  rootTurnID?: string
+  messageID: string
+  turnID: string
+  callID: string
+  command: string
+  cwd: string
+  shell: string
+  startedAt: number
+  lastOutputAt: number
+  endedAt?: number
+  status: Status
+  pid?: number
+  backendPID?: number
+  exitCode?: number
+  reason?: string
+  cursor: number
+  baseCursor: number
+  segments: { name: string; start: number; size: number }[]
+}
+export type Control = {
+  needsInput?: boolean
+  nextCheckAt?: number
+  consumed?: boolean
+  suppressed?: boolean
+  hidden?: boolean
+  error?: string
+}
+export type Settings = { taskRecovery?: "auto" | "manual"; stopBehavior?: "all" | "ai" }
+export const home = () => path.resolve(process.env.CODA_HOME || path.join(os.homedir(), ".coda"))
+export const root = () => path.join(home(), "terminals")
+export type Owner = { id: string; pid: number; at: number; exiting: boolean }
+export function owner() {
+  const value = json<Owner>(path.join(home(), "runtime", "desktop.json"))
+  if (!value || value.exiting) throw new Error("Coda desktop is not running or is exiting")
+  try {
+    process.kill(value.pid, 0)
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code !== "EPERM") throw new Error("Coda desktop is no longer running")
+  }
+  return value
+}
+export const active = (info: Info) => info.status === "starting" || info.status === "running"
+export function taskDir(id: string) {
+  if (!/^term_[a-f0-9]{32}$/.test(id)) throw new Error("Invalid terminal ID")
+  return path.join(root(), id)
+}
+export function atomic(file: string, value: unknown) {
+  const tmp = `${file}.${randomUUID()}.tmp`
+  fs.writeFileSync(tmp, JSON.stringify(value), { mode: 0o600 })
+  fs.renameSync(tmp, file)
+}
+export function json<T>(file: string): T | undefined {
+  try {
+    return JSON.parse(fs.readFileSync(file, "utf8")) as T
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return undefined
+    throw error
+  }
+}
+export const settings = () => json<Settings>(path.join(home(), "settings.json")) ?? {}
+export const read = (id: string) => json<Info>(path.join(taskDir(id), "info.json"))
+export const control = (id: string) => json<Control>(path.join(taskDir(id), "control.json")) ?? {}
+export function update(id: string, patch: Partial<Control>) {
+  atomic(path.join(taskDir(id), "control.json"), { ...control(id), ...patch })
+}
+export function list(directory?: string, sessionID?: string) {
+  fs.mkdirSync(root(), { recursive: true, mode: 0o700 })
+  return fs
+    .readdirSync(root())
+    .filter((id) => /^term_[a-f0-9]{32}$/.test(id))
+    .flatMap((id) => {
+      const info = read(id)
+      return info &&
+        (!directory || info.directory === path.resolve(directory)) &&
+        (!sessionID || info.sessionID === sessionID || info.rootSessionID === sessionID)
+        ? [{ ...info, ...control(id) }]
+        : []
+    })
+    .sort((a, b) => a.startedAt - b.startedAt)
+}
+export function idFor(sessionID: string, callID: string) {
+  return "term_" + createHash("sha256").update(`${sessionID}\0${callID}`).digest("hex").slice(0, 32)
+}
+export function log(info: Info, cursor?: number, limit = 64 * 1024) {
+  const requested = cursor ?? Math.max(info.baseCursor, info.cursor - limit)
+  let at = Math.max(info.baseCursor, Math.min(info.cursor, requested))
+  const start = at
+  const chunks: Buffer[] = []
+  let left = Math.min(limit, 256 * 1024)
+  for (const segment of info.segments) {
+    if (!left || segment.start + segment.size <= at) continue
+    const offset = Math.max(0, at - segment.start)
+    const size = Math.min(segment.size - offset, left)
+    if (size <= 0) continue
+    let fd: number | undefined
+    try {
+      fd = fs.openSync(path.join(taskDir(info.id), segment.name), "r")
+      const bytes = Buffer.alloc(size)
+      const n = fs.readSync(fd, bytes, 0, size, offset)
+      chunks.push(bytes.subarray(0, n))
+      at = segment.start + offset + n
+      left -= n
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error
+    } finally {
+      if (fd !== undefined) fs.closeSync(fd)
+    }
+  }
+  return {
+    data: Buffer.concat(chunks).toString("base64"),
+    start,
+    cursor: at,
+    baseCursor: info.baseCursor,
+    endCursor: info.cursor,
+    truncated: requested < info.baseCursor,
+  }
+}
+export function cleanup() {
+  for (const info of list())
+    if (!active(info) && info.endedAt && Date.now() - info.endedAt > 7 * 86400_000)
+      fs.rmSync(taskDir(info.id), { recursive: true, force: true })
+}
+
+export type Run = {
+  sessionID: string
+  ownerID: string
+  turnID: string
+  backendID: string
+  active: boolean
+  suppressed?: boolean
+}
+function runPath(sessionID: string) {
+  if (!/^[a-zA-Z0-9_-]{1,128}$/.test(sessionID)) throw new Error("Invalid session ID")
+  const folder = path.join(home(), "runs")
+  fs.mkdirSync(folder, { recursive: true, mode: 0o700 })
+  return path.join(folder, `${sessionID}.json`)
+}
+export const run = (sessionID: string) => json<Run>(runPath(sessionID))
+export function saveRun(value: Run) {
+  atomic(runPath(value.sessionID), value)
+}
diff --git a/packages/opencode/src/terminal/tools.ts b/packages/opencode/src/terminal/tools.ts
new file mode 100644
index 0000000000..2338760108
--- /dev/null
+++ b/packages/opencode/src/terminal/tools.ts
@@ -0,0 +1,107 @@
+import path from "node:path"
+import { Effect, Schema } from "effect"
+import { Tool } from "../tool/tool"
+import { InstanceState } from "../effect/instance-state"
+import * as Client from "./client"
+import * as Store from "./store"
+
+export function result(info: Store.Info, cursor?: number) {
+  const output = Store.log(info, cursor, 24 * 1024)
+  const text = Buffer.from(output.data, "base64").toString("utf8")
+  const running = Store.active(info)
+  const needsInput = Store.control(info.id).needsInput === true
+  const silent = Date.now() - info.lastOutputAt > 300_000
+  return {
+    title: info.command,
+    metadata: { terminalID: info.id, terminalStatus: info.status, exit: info.exitCode, cursor: output.cursor },
+    output: JSON.stringify({
+      task_id: info.id,
+      status: info.status,
+      exit_code: info.exitCode,
+      cursor: output.cursor,
+      output: text || "(no new output)",
+      truncated: output.truncated,
+      has_more_output: output.cursor < output.endCursor,
+      reason: info.reason,
+      needs_input: needsInput,
+      silent_for_five_minutes: silent,
+      instruction:
+        needsInput && running
+          ? "The command appears to require interactive input. This terminal is read-only: explain the blocker to the user, cancel or replace the command with an authorized non-interactive operation. Do not keep waiting blindly."
+          : running
+            ? "Command is still running. Use shell_wait with this task_id and cursor; wait_ms normally 30000, or 60000 if unchanged (maximum 120000). Do not rerun the command. Inspect authentication or interactive prompts; never invent a completion ETA."
+            : "Command has ended. Inspect its exit status before continuing.",
+    }),
+  }
+}
+
+export function execute(
+  input: {
+    shell: string
+    command: string
+    cwd: string
+    directory: string
+    env: NodeJS.ProcessEnv
+    timeout?: number
+    wait_ms?: number
+  },
+  ctx: Tool.Context,
+) {
+  return Effect.gen(function* () {
+    const info = yield* Effect.promise(() =>
+      Client.start({
+        ...input,
+        rootSessionID: String(ctx.extra?.rootSessionID ?? ctx.sessionID),
+        rootTurnID: typeof ctx.extra?.rootTurnID === "string" ? ctx.extra.rootTurnID : undefined,
+        sessionID: ctx.sessionID,
+        messageID: ctx.messageID,
+        turnID: ctx.messages.findLast((item) => item.info.role === "user")?.info.id ?? ctx.messageID,
+        callID: ctx.callID ?? ctx.messageID,
+      }),
+    )
+    const waitMs = Math.max(1, Math.min(120_000, input.wait_ms ?? 10_000))
+    yield* ctx.metadata({ metadata: { terminalID: info.id, nextCheckAt: Date.now() + waitMs } })
+    const next = yield* Effect.promise(() => Client.wait(info.id, waitMs, ctx.abort))
+    return result(next)
+  })
+}
+
+const params = {
+  task_id: Schema.String,
+  cursor: Schema.optional(Schema.Number.check(Schema.isInt(), Schema.isGreaterThanOrEqualTo(0))),
+}
+const WaitParameters = Schema.Struct({
+  ...params,
+  wait_ms: Schema.optional(
+    Schema.Number.check(Schema.isInt(), Schema.isGreaterThanOrEqualTo(0), Schema.isLessThanOrEqualTo(120_000)),
+  ),
+})
+
+function define(name: "shell_wait" | "shell_status" | "shell_cancel") {
+  return Tool.define(
+    name,
+    Effect.succeed({
+      description:
+        name === "shell_wait"
+          ? "Wait for an existing shell command, returning immediately on completion. Time is the next check interval, not a command timeout or completion ETA. Pass the previous cursor to receive only new output. Default 30 seconds; use 60 seconds when unchanged, maximum 120 seconds."
+          : name === "shell_cancel"
+            ? "Stop an existing shell command and its process tree."
+            : "Read an existing shell command's status and new output without waiting.",
+      parameters: WaitParameters,
+      execute: (input: typeof WaitParameters.Type, ctx: Tool.Context) =>
+        Effect.gen(function* () {
+          const directory = path.resolve((yield* InstanceState.context).directory)
+          const info = yield* Effect.promise(() => Client.refresh(input.task_id))
+          if (info.directory !== directory || info.sessionID !== ctx.sessionID)
+            throw new Error("Terminal does not belong to this session")
+          if (name === "shell_cancel") return result(yield* Effect.promise(() => Client.cancel(info.id)), input.cursor)
+          const ms = name === "shell_wait" ? (input.wait_ms ?? 30_000) : 0
+          yield* ctx.metadata({ metadata: { terminalID: info.id, nextCheckAt: Date.now() + ms } })
+          return result(yield* Effect.promise(() => Client.wait(info.id, ms, ctx.abort)), input.cursor)
+        }),
+    }),
+  )
+}
+export const Wait = define("shell_wait")
+export const Status = define("shell_status")
+export const Cancel = define("shell_cancel")
