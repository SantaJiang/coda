{
  "name": "coda",
  "version": "1.7.0",
  "description": "Coda — 精简桌面 Agent 客户端",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev:watch": "bash scripts/vite-dev.sh",
    "build": "bun run typecheck && vite build",
    "before-tauri-build": "bash ../scripts/build-sidecar.sh && bun run build",
